{
 "s1_01": {
  "who": "samir",
  "dur": 4.4,
  "wer": 0.0,
  "asr": "Ой, ясми! Осторожно! Это же книга про подсолнухи!"
 },
 "s1_02": {
  "who": "yasmina",
  "dur": 3.2,
  "wer": 0.0,
  "asr": "Прости, прости, я спешу поливать."
 },
 "s1_03": {
  "who": "samir",
  "dur": 4.4,
  "wer": 0.0,
  "asr": "Поливать? А что поливать? Мы же еще ничего не посадили."
 },
 "s1_04": {
  "who": "leyla",
  "dur": 2.24,
  "wer": 0.0,
  "asr": "А вот сейчас и посадим."
 },
 "s1_05": {
  "who": "leyla",
  "dur": 7.2,
  "wer": 0.0,
  "asr": "Смотрите, это семечко из бабушкиного сада.  Посадите его и увидите чудо."
 },
 "s1_06": {
  "who": "yasmina",
  "dur": 2.8,
  "wer": 0.0,
  "asr": "Чудо! Настоящее!"
 },
 "s1_07": {
  "who": "samir",
  "dur": 4.32,
  "wer": 0.5,
  "asr": "Дай-ка посмотрю. Обычная семечка."
 },
 "s1_08": {
  "who": "leyla",
  "dur": 2.16,
  "wer": 0.0,
  "asr": "Обычное пока не вырастет."
 },
 "s2_01": {
  "who": "yasmina",
  "dur": 2.32,
  "wer": 0.0,
  "asr": "Бисмиллях! Расти семечко!"
 },
 "s2_02": {
  "who": "yasmina",
  "dur": 2.56,
  "wer": 0.17,
  "asr": "Ну, и где же чудо?"
 },
 "s2_03": {
  "who": "samir",
  "dur": 3.28,
  "wer": 0.0,
  "asr": "Ясми, оно не вырастет за одну минуту!"
 },
 "s2_04": {
  "who": "yasmina",
  "dur": 1.68,
  "wer": 0.0,
  "asr": "А за две?"
 },
 "s2_05": {
  "who": "samir",
  "dur": 5.84,
  "wer": 0.0,
  "asr": "Стой, стой, стой! В книге написано «поливать понемногу»."
 },
 "s2_06": {
  "who": "yasmina",
  "dur": 4.08,
  "wer": 0.33,
  "asr": "Понемногу? Это же так долго!"
 },
 "s3_01": {
  "who": "yasmina",
  "dur": 6.32,
  "wer": 0.0,
  "asr": "Целый день прошел, а оно все спит. Наверное, сломалось."
 },
 "s3_02": {
  "who": "samir",
  "dur": 2.32,
  "wer": 0.0,
  "asr": "Ясми, не надо."
 },
 "s3_03": {
  "who": "yasmina",
  "dur": 5.6,
  "wer": 0.0,
  "asr": "Ой, у него хвостик. Я... я его сломала."
 },
 "s3_04": {
  "who": "leyla",
  "dur": 2.32,
  "wer": 0.0,
  "asr": "Иди ко мне, солнышко, покажи-ка"
 },
 "s3_05": {
  "who": "leyla",
  "dur": 4.32,
  "wer": 0.11,
  "asr": "Нет, не сломала. Это корешок. Видишь, семечка уже растет."
 },
 "s3_06": {
  "who": "yasmina",
  "dur": 1.84,
  "wer": 0.0,
  "asr": "Но его же совсем не видно."
 },
 "s3_07": {
  "who": "leyla",
  "dur": 8.0,
  "wer": 0.0,
  "asr": "Потому что сначала оно растет вниз, в темноте, где никто не видит, корни всегда первые."
 },
 "s3_08": {
  "who": "samir",
  "dur": 2.08,
  "wer": 0.0,
  "asr": "как фундамент у дома."
 },
 "s3_09": {
  "who": "leyla",
  "dur": 5.84,
  "wer": 0.0,
  "asr": "Вот-вот, терпение — это не просто сидеть и ждать, это ждать и заботиться."
 },
 "s3_10": {
  "who": "yasmina",
  "dur": 2.24,
  "wer": 0.0,
  "asr": "А если я не умею ждать?"
 },
 "s3_11": {
  "who": "leyla",
  "dur": 6.56,
  "wer": 0.0,
  "asr": "Тогда будем учиться вместе, Аллах с терпеливыми, так сказано в Коране."
 },
 "s3_12": {
  "who": "samir",
  "dur": 3.44,
  "wer": 0.0,
  "asr": "Давай посадим его обратно. Вместе."
 },
 "s4_01": {
  "who": "samir",
  "dur": 4.88,
  "wer": 0.0,
  "asr": "Вот расписание. Каждое утро одна кружка воды, не больше."
 },
 "s4_02": {
  "who": "yasmina",
  "dur": 1.84,
  "wer": 0.0,
  "asr": "Одна кружка. Поняла."
 },
 "s4_03": {
  "who": "yasmina",
  "dur": 2.0,
  "wer": 0.0,
  "asr": "Кыш-голубь, это не тебе!"
 },
 "s4_04": {
  "who": "yasmina",
  "dur": 3.68,
  "wer": 0.2,
  "asr": "Калючкин, нельзя! Это мой подсолнушек!"
 },
 "s4_05": {
  "who": "yasmina",
  "dur": 3.76,
  "wer": 0.0,
  "asr": "Мама! Самир! Оно проснулось!"
 },
 "s4_06": {
  "who": "samir",
  "dur": 2.0,
  "wer": 0.0,
  "asr": "Ого! Два листика!"
 },
 "s4_07": {
  "who": "leyla",
  "dur": 3.68,
  "wer": 0.29,
  "asr": "Маше Аллах, видишь, как красиво, когда не торопишь."
 },
 "s5_01": {
  "who": "yasmina",
  "dur": 3.28,
  "wer": 0.5,
  "asr": "Мама, ветер, под солнух сломается."
 },
 "s5_02": {
  "who": "leyla",
  "dur": 3.84,
  "wer": 0.0,
  "asr": "Держи его вот так.  Самир, неси палочку."
 },
 "s5_03": {
  "who": "samir",
  "dur": 2.88,
  "wer": 0.0,
  "asr": "Палочка есть, а веревки нет."
 },
 "s5_04": {
  "who": "yasmina",
  "dur": 2.56,
  "wer": 0.0,
  "asr": "Возьми мою ленточку"
 },
 "s5_05": {
  "who": "leyla",
  "dur": 3.6,
  "wer": 0.0,
  "asr": "Умница ты моя. Вот так. Теперь не упадет."
 },
 "s5_06": {
  "who": "yasmina",
  "dur": 2.88,
  "wer": 0.4,
  "asr": "Держись под солнышек.  Мы с тобой."
 },
 "s6_01": {
  "who": "leyla",
  "dur": 5.44,
  "wer": 0.22,
  "asr": "Альхамда лиля, оно пришло вовремя, не раньше и не позже."
 },
 "s6_02": {
  "who": "yasmina",
  "dur": 2.88,
  "wer": 0.0,
  "asr": "Мама, а терпение – это тоже чудо?"
 },
 "s6_03": {
  "who": "leyla",
  "dur": 2.32,
  "wer": 0.0,
  "asr": "Самое трудное чудо, солнышко."
 },
 "s6_04": {
  "who": "yasmina",
  "dur": 1.76,
  "wer": 0.0,
  "asr": "Самир, а что ты делаешь?"
 },
 "s6_05": {
  "who": "samir",
  "dur": 4.64,
  "wer": 0.0,
  "asr": "Сажаю печенье. Буду ждать печеньковое дерево. Я же теперь терпеливый."
 },
 "s6_06": {
  "who": "yasmina",
  "dur": 2.96,
  "wer": 0.0,
  "asr": "Ой, Самир, ну ты даёшь!"
 },
 "s6_07": {
  "who": "leyla",
  "dur": 4.0,
  "wer": 0.0,
  "asr": "Пойдемте пить чай. С печеньем."
 },
 "r_yas_giggle": {
  "who": "yasmina",
  "dur": 0.96,
  "wer": 0.0,
  "asr": "Хи-хи!"
 },
 "r_yas_wow": {
  "who": "yasmina",
  "dur": 1.44,
  "wer": 0.0,
  "asr": "Ух ты!"
 },
 "r_yas_sigh": {
  "who": "yasmina",
  "dur": 1.2,
  "wer": 0.0,
  "asr": "Эх."
 },
 "r_samir_laugh": {
  "who": "samir",
  "dur": 1.44,
  "wer": 1.0,
  "asr": "СМЕХ"
 },
 "r_samir_hmm": {
  "who": "samir",
  "dur": 1.2,
  "wer": 1.0,
  "asr": "Хмм..."
 },
 "r_leyla_laugh": {
  "who": "leyla",
  "dur": 1.12,
  "wer": 1.0,
  "asr": "Хе-хе"
 }
}